{
  "name": "Holy Grail POS",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": { "openFiles": ["README.md", "app.py"] },
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance"]
    }
  },
  "updateContentCommand": "pip3 install --user -r requirements.txt && python -m scripts.init_db --demo",
  "postAttachCommand": "streamlit run app.py",
  "portsAttributes": { "8501": { "label": "Aplikasi", "onAutoForward": "openPreview" } },
  "forwardPorts": [8501]
}
