# Salin ke .env lalu isi. JANGAN commit .env.
# Kosongkan DATABASE_URL untuk memakai SQLite lokal: data/holygrail.db
# PostgreSQL contoh: postgresql+psycopg2://USER:PASSWORD@HOST:5432/holygrail
DATABASE_URL=

STORE_NAME=Holy Grail Resto

# Akun awal (dibuat oleh `python -m scripts.init_db`). Minimal 8 karakter, huruf + angka.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
KASIR_USERNAME=kasir
KASIR_PASSWORD=

# Pembatas login (per sesi)
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_SECONDS=60
